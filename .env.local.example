# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Password for the dedicated App Store Review test account (appreview@trackdownpoker.com).
# Also needs to be set in Railway's environment variables for production.
NEXT_PUBLIC_APP_REVIEW_PASSWORD=

# RevenueCat public API key (Project settings -> API keys -> Apple App Store).
# Also needs to be set in Railway's environment variables for production.
NEXT_PUBLIC_REVENUECAT_API_KEY=

# The entitlement identifier configured in the RevenueCat dashboard.
# Defaults to "pro" in code if unset — only set this if you named it something else.
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=
